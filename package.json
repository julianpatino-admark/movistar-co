{
  "name": "movistar-col",
  "version": "1.0.0",
  "description": "Dependencias gulp landing",
  "main": "generica.js",
  "type": "module",
  "scripts": {
    "dev": "VITE_COVERAGE=true vite",
    "build": "VITE_COVERAGE=true vite build",
    "pack:prod": "VITE_COVERAGE=true vite build && zip -r core_update.zip resources/views app config routes -x \"*.DS_Store\" -x \"*Zone.Identifier\" && zip -r public_update.zip public/build -x \"*.DS_Store\" -x \"*Zone.Identifier\"",
    "pretest:e2e": "node -e \"fs.rmSync('tests/e2e/coverage-reports', { recursive: true, force: true })\"",
    "test:e2e": "playwright test",
    "posttest:e2e": "nyc report --reporter=lcov --temp-dir=tests/e2e/coverage-reports/.nyc_output --report-dir=tests/e2e/coverage-reports"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "admark-landings": "git+ssh://git@bitbucket.org:grupokonecta/web-npm-js-landings.git#1.6.21"
  },
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/plugin-proposal-class-properties": "^7.16.0",
    "@babel/plugin-proposal-decorators": "^7.16.4",
    "@babel/plugin-transform-arrow-functions": "^7.16.0",
    "@babel/plugin-transform-runtime": "^7.16.4",
    "@babel/preset-env": "^7.16.4",
    "@codeceptjs/configure": "^1.0.1",
    "@codeceptjs/examples": "^1.2.3",
    "@codeceptjs/ui": "^1.2.0",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@playwright/test": "^1.58.1",
    "@types/node": "^20.19.32",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "babel-loader": "^8.2.3",
    "babel-plugin-istanbul": "^8.0.0",
    "codeceptjs": "^3.5.11",
    "eslint": "^8.25.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "gulp-landings": "git+ssh://git@bitbucket.org:grupokonecta/web-npm-gulp-landings.git#3.1.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "laravel-vite-plugin": "^2.0.1",
    "lodash": "^4.17.19",
    "mini-css-extract-plugin": "^2.7.7",
    "monocart-reporter": "^2.10.0",
    "nyc": "^18.0.0",
    "playwright": "^1.42.1",
    "playwright-coverage": "^0.0.1-security",
    "prettier": "^2.7.1",
    "purgecss-webpack-plugin": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^7.2.6",
    "vite-plugin-istanbul": "^8.0.0"
  },
  "author": "Admark B12",
  "license": "ISC"
}
