{
  "name": "movistar-col",
  "version": "1.0.0",
  "description": "Landings Movistar Colombia con Laravel y Vite",
  "type": "module",
  "scripts": {
    "dev": "VITE_COVERAGE=true vite",
    "build": "vite build",
    "build:coverage": "VITE_COVERAGE=true vite build",
    "pack:prod": "VITE_COVERAGE=true find . -name '*:Zone.Identifier' -not -path './node_modules/*' -not -path './.git/*' -delete && vite build && zip -r core_update.zip resources/views app bootstrap cache config database lang storage routes && zip -r public_update.zip public/build",
    "pretest:e2e": "node -e \"fs.rmSync('tests/e2e/coverage-reports', { recursive: true, force: true })\"",
    "test:e2e": "playwright test",
    "posttest:e2e": "nyc report --reporter=lcov --temp-dir=tests/e2e/coverage-reports/.nyc_output --report-dir=tests/e2e/coverage-reports"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "admark-landings": "git+ssh://git@bitbucket.org:grupokonecta/web-npm-js-landings.git#1.6.21"
  },
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@playwright/test": "^1.58.1",
    "@types/node": "^20.19.32",
    "babel-plugin-istanbul": "^8.0.0",
    "eslint": "^8.25.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "laravel-vite-plugin": "^2.0.1",
    "lodash": "^4.17.19",
    "monocart-reporter": "^2.10.0",
    "nyc": "^18.0.0",
    "playwright": "^1.42.1",
    "playwright-coverage": "^0.0.1-security",
    "prettier": "^2.7.1",
    "sass": "^1.97.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^7.2.6",
    "vite-plugin-istanbul": "^8.0.0"
  },
  "author": "Admark B12",
  "license": "ISC"
}
