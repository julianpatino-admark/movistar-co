APP_NAME="Telefonica Movistar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SEO_PUBLIC_URL=https://ofertastienda.co

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CORS_ALLOWED_ORIGINS=

# Anubis
# Integración actualmente deshabilitada para generación de idLead.
ANUBIS_USER=
ANUBIS_PASSWORD=
ANUBIS_URL=https://wsc2c.tlmark.com/Digital.asmx?WSDL
ANUBIS_CLIENT=
ANUBIS_GENERATE_ID=false

TRACKING_WEBHOOK_PASSWORD=

# GoContact
GOCONTACT_BASE_URL=
GOCONTACT_USERNAME=
GOCONTACT_PASSWORD=
GOCONTACT_DATABASE_ID=44
GOCONTACT_ALTERNATE_DATABASE_ID=56
# Porcentaje entero entre 0 y 100; el restante va a la BD principal.
GOCONTACT_ALTERNATE_PERCENTAGE=40
GOCONTACT_BASE_PATH=/poll
GOCONTACT_TOKEN_PATH=/auth/token
GOCONTACT_CONTACTS_PATH=/api/databases/{database}/contacts
GOCONTACT_CONNECT_TIMEOUT=10
GOCONTACT_TIMEOUT=30
MONITOR_CACHE_STORE=database
MONITOR_PUBLIC_URL=https://ofertastienda.co
MONITOR_PASSWORD_RESET_EMAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Ofertas Tienda"
