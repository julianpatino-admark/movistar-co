APP_NAME="Telefonica Movistar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CORS_ALLOWED_ORIGINS=

# Anubis
# Integración actualmente deshabilitada para generación de idLead.
ANUBIS_USER=
ANUBIS_PASSWORD=
ANUBIS_URL=https://wsc2c.tlmark.com/Digital.asmx?WSDL
ANUBIS_CLIENT=
ANUBIS_GENERATE_ID=false

TRACKING_WEBHOOK_PASSWORD=

# GoContact
GOCONTACT_BASE_URL=
GOCONTACT_USERNAME=
GOCONTACT_PASSWORD=
GOCONTACT_DATABASE_ID=
GOCONTACT_BASE_PATH=/poll
GOCONTACT_TOKEN_PATH=/auth/token
GOCONTACT_CONTACTS_PATH=/api/databases/{database}/contacts
GOCONTACT_CONNECT_TIMEOUT=10
GOCONTACT_TIMEOUT=30
GOCONTACT_MONITOR_USERNAME=
GOCONTACT_MONITOR_PASSWORD=