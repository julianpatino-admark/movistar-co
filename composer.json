{
  "name": "laravel/laravel",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^7.2",
    "laravel/framework": "^12.72",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.7",
    "admark/tracking": "^12.0",
    "admark/inconcert": "^12.0",
    "admark/anubis": "^12.0",
    "admark/gocontact": "^1.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9.1",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.0.1",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5",
    "spatie/laravel-ignition": "^2.9",
    "admark/commands" : "^12.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/admark/gocontact",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "git",
      "url": "git@bitbucket.org:grupokonecta/web-composer-laravel-tracking.git"
    },
    {
      "type": "path",
      "url": "packages/admark/anubis",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "git",
      "url": "git@bitbucket.org:grupokonecta/web-composer-laravel-soap.git"
    },
    {
      "type": "git",
      "url": "git@bitbucket.org:grupokonecta/web-composer-laravel-inconcert.git"
    },
    {
      "type": "git",
      "url": "git@bitbucket.org:grupokonecta/web-composer-laravel-landing-commands.git"
    },
    {
      "type": "git",
      "url": "git@bitbucket.org:grupokonecta/web-composer-laravel-time-helpers.git"
    }
  ],
  "autoload": {
    "classmap": [
      "database/seeders",
      "database/factories"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "admark/tracking"
      ]
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
