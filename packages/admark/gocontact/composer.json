{
  "name": "admark/gocontact",
  "description": "Laravel integration for submitting leads to GoContact",
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",
  "require": {
    "php": "^8.0.2",
    "illuminate/cache": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "illuminate/config": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "illuminate/database": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "illuminate/events": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "illuminate/http": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "Admark\\GoContact\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Admark\\GoContact\\GoContactServiceProvider"
      ]
    }
  }
}
